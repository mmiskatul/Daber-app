{
  "expo": {
    "name": "Daber",
    "slug": "daber-app",
    "scheme": "daber",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Daber to access your microphone for spoken Hebrew practice."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.daber.app"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.daber.app"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "382e0919-cafe-4c2f-a45f-7e5f944c308d"
      }
    }
  }
}
